# === REQUIRED — server fails fast at startup if missing ===
DATABASE_URL=postgres://agentwatch:agentwatch_dev_password@localhost:5432/agentwatch
# If using PgBouncer transaction-mode, append ?pgbouncer=true (requires PgBouncer >= 1.21).
# See README → Deployment → PgBouncer for details.

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# === SET AFTER SETUP WIZARD COMPLETES ===
WORKSPACE_ID=
AGENTWATCH_INTERNAL_API_KEY=

# === OPTIONAL — sensible defaults ===
IDENTITY_CONFIDENCE_THRESHOLD=0.8
LOG_LEVEL=info
TELEMETRY_OPT_IN=false
PORT=8080

# Web container only (set automatically inside docker-compose):
AGENTWATCH_INTERNAL_URL=http://localhost:8080

# Postgres password used by docker-compose:
POSTGRES_PASSWORD=agentwatch_dev_password
