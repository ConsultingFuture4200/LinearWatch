{
  "name": "@linearwatch/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@linearwatch/shared": "workspace:^",
    "drizzle-orm": "0.45.2",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.31.10",
    "vitest": "2.1.5"
  }
}
