{
  "name": "@linearwatch/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "linearwatch": "./bin/linearwatch.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench:webhook-ack": "tsx test/perf/webhook-ack.bench.ts"
  },
  "dependencies": {
    "@linearwatch/db": "workspace:^",
    "@linearwatch/shared": "workspace:^",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "fastify-plugin": "5.0.1",
    "graphile-worker": "0.16.6",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "autocannon": "7.15.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.19.2",
    "vitest": "2.1.5"
  }
}
